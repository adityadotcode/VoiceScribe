# ──────────────────────────────────────────────────────────────────────────────
# VoiceScribe — client environment variables (Vite)
# Copy to .env.local (or .env) and fill in for production.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the deployed backend API.
# Leave blank (or omit) for local development — the Vite proxy handles it.
# Example: https://api.voicescribe.example.com
VITE_API_BASE_URL=
