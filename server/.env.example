# ──────────────────────────────────────────────────────────────────────────────
# VoiceScribe — server environment variables
# Copy this file to .env and fill in the values.  Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# Express server port.
# EC2 production: set to 3000 (or 80 if running as root / with authbind).
PORT=3000

# Allowed CORS origin for the React frontend.
# Single-origin (EC2 + CloudFront): set to the CloudFront HTTPS URL.
# Local development: http://localhost:5174
CLIENT_ORIGIN=http://localhost:5174

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# AWS region where S3, Transcribe, and Bedrock resources live.
AWS_REGION=ap-southeast-2

# S3 bucket used for temporary audio uploads.
S3_BUCKET_NAME=

# Maximum audio upload size in bytes (default 25 MB = 26214400).
MAX_AUDIO_FILE_BYTES=26214400

# NODE_ENV — set to "production" on EC2 so Express serves the React build.
# Leave unset or "development" for local dev (Vite dev server handles the frontend).
NODE_ENV=production

# ── Phase 1A (V2 Authentication) — REQUIRED from Phase 1A onwards ────────────
# Generate secure random values before running Phase 1A.
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET and JWT_REFRESH_SECRET must be DIFFERENT values.
# Never share or commit these values.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── AWS credentials ────────────────────────────────────────────────────────────
# Leave blank when running on an EC2 instance with an IAM role attached.
# Only set for local development without aws-cli profiles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
