# ──────────────────────────────────────────────────────────────────────────────
# VoiceScribe — server environment variables
# Copy this file to .env and fill in the values.  Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# Express server port
PORT=5000

# Allowed CORS origin for the React frontend.
# Local development:  http://localhost:5174
# Production:         https://your-frontend-domain.example.com
CLIENT_ORIGIN=http://localhost:5174

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# AWS region where S3, Transcribe, and Bedrock resources live.
AWS_REGION=ap-southeast-2

# S3 bucket used for temporary audio uploads.
S3_BUCKET_NAME=

# Maximum audio upload size in bytes (default: 25 MB).
MAX_AUDIO_FILE_BYTES=26214400

# AWS credentials — leave blank when running on an IAM-role-enabled host
# (EC2, ECS, App Runner, Lambda).  Only set for local development if you
# are not using aws-cli profiles or environment-level role assumption.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
